@@ -0,0 +1,30 @@
+/*
+ * Copyright © 2026 NVBringup contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * macOS builds have no mesa_clc (it needs LLVM), so the two OpenCL C kernels in
+ * cl/ are written directly with nir_builder here. Same signatures as the
+ * vtn_bindgen2 output they replace; the bodies are inlined instead of called.
+ */
+#pragma once
+
+#include "compiler/nir/nir.h"
+#include "compiler/nir/nir_builder.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* cl/nvk_query.cl */
+void nvk_copy_queries(nir_builder *b, nir_def *pool_addr, nir_def *available_stride,
+                      nir_def *reports_start, nir_def *report_count, nir_def *query_stride,
+                      nir_def *first_query, nir_def *query_count, nir_def *dst_addr,
+                      nir_def *dst_stride, nir_def *flags);
+
+/* cl/nvk_copy_indirect.cl */
+void nvk_copy_indirect(nir_builder *b, nir_def *in, nir_def *in_stride, nir_def *out,
+                       nir_def *count);
+
+#ifdef __cplusplus
+}
+#endif
