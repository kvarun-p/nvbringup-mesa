diff --git a/src/nouveau/vulkan/macos_nvkcl/nvkcl.c b/src/nouveau/vulkan/macos_nvkcl/nvkcl.c
new file mode 100644
index 00000000..b37a71a5
--- /dev/null
+++ b/src/nouveau/vulkan/macos_nvkcl/nvkcl.c
@@ -0,0 +1,137 @@
+/*
+ * Copyright © 2026 NVBringup contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Hand-written NIR equivalents of cl/nvk_query.cl and cl/nvk_copy_indirect.cl
+ * (see nvkcl.h). Keep them in step with the OpenCL sources.
+ */
+#include "nvkcl.h"
+
+#include "nv_push.h"
+#include "nv_push_cl90b5.h"
+#include "../cl/nvk_copy_indirect.h"
+
+/* VkQueryResultFlagBits */
+#define QUERY_RESULT_64_BIT                0x1
+#define QUERY_RESULT_WITH_AVAILABILITY_BIT 0x4
+
+/* libcl_vk.h vk_write_query(): 64- or 32-bit result idx at dst_addr */
+static void
+write_query(nir_builder *b, nir_def *dst_addr, nir_def *idx, nir_def *flags, nir_def *result)
+{
+   nir_def *is64 = nir_i2b(b, nir_iand_imm(b, flags, QUERY_RESULT_64_BIT));
+   nir_def *idx64 = nir_u2u64(b, idx);
+   nir_push_if(b, is64);
+   {
+      nir_store_global(b, result, nir_iadd(b, dst_addr, nir_imul_imm(b, idx64, 8)), .align_mul = 8);
+   }
+   nir_push_else(b, NULL);
+   {
+      nir_store_global(b, nir_u2u32(b, result), nir_iadd(b, dst_addr, nir_imul_imm(b, idx64, 4)),
+                       .align_mul = 4);
+   }
+   nir_pop_if(b, NULL);
+}
+
+/* One invocation per query: i = subgroup lane + workgroup id * 32 (workgroups are 32 wide). */
+static nir_def *
+invocation_index(nir_builder *b)
+{
+   return nir_channel(b, nir_load_global_invocation_id(b, 32), 0);
+}
+
+void
+nvk_copy_queries(nir_builder *b, nir_def *pool_addr, nir_def *available_stride,
+                 nir_def *reports_start, nir_def *report_count, nir_def *query_stride,
+                 nir_def *first_query, nir_def *query_count, nir_def *dst_addr,
+                 nir_def *dst_stride, nir_def *flags)
+{
+   nir_def *i = invocation_index(b);
+   nir_push_if(b, nir_ult(b, i, query_count));
+   {
+      nir_def *query = nir_iadd(b, first_query, i);
+      nir_def *available_offs = nir_imul(b, nir_u2u64(b, query), nir_u2u64(b, available_stride));
+      nir_def *available =
+         nir_b2i32(b, nir_ine_imm(b, nir_load_global(b, 1, 32, nir_iadd(b, pool_addr, available_offs),
+                                                      .align_mul = 4), 0));
+
+      nir_def *report_offs = nir_iadd(b, nir_u2u64(b, reports_start),
+                                      nir_imul(b, nir_u2u64(b, query), nir_u2u64(b, query_stride)));
+      nir_def *report = nir_iadd(b, pool_addr, report_offs);
+      nir_def *dst = nir_iadd(b, dst_addr, nir_imul(b, dst_stride, nir_u2u64(b, i)));
+
+      /* for (r = 0; r < report_count; r++) write_query(dst, r, flags, report[r * 2]) */
+      nir_variable *r_var = nir_local_variable_create(b->impl, glsl_uint_type(), "r");
+      nir_store_var(b, r_var, nir_imm_int(b, 0), 1);
+      nir_loop *loop = nir_push_loop(b);
+      {
+         nir_def *r = nir_load_var(b, r_var);
+         nir_break_if(b, nir_uge(b, r, report_count));
+         nir_def *addr = nir_iadd(b, report, nir_imul_imm(b, nir_u2u64(b, r), 16));
+         write_query(b, dst, r, flags, nir_load_global(b, 1, 64, addr, .align_mul = 8));
+         nir_store_var(b, r_var, nir_iadd_imm(b, r, 1), 1);
+      }
+      nir_pop_loop(b, loop);
+
+      nir_push_if(b, nir_i2b(b, nir_iand_imm(b, flags, QUERY_RESULT_WITH_AVAILABILITY_BIT)));
+      {
+         write_query(b, dst, report_count, flags, nir_u2u64(b, available));
+      }
+      nir_pop_if(b, NULL);
+   }
+   nir_pop_if(b, NULL);
+}
+
+void
+nvk_copy_indirect(nir_builder *b, nir_def *in, nir_def *in_stride, nir_def *out, nir_def *count)
+{
+   /* The fixed words of the command, built with the same push macros as the
+    * OpenCL version; the data words are filled in per invocation.
+    */
+   uint32_t tmpl[NVK_COPY_INDIRECT_CMD_WORDS];
+   struct nv_push push;
+   struct nv_push *p = &push;
+   nv_push_init(p, tmpl, ARRAY_SIZE(tmpl), BITFIELD_BIT(SUBC_NV90B5));
+   P_MTHD(p, NV90B5, OFFSET_IN_UPPER);
+   P_NV90B5_OFFSET_IN_UPPER(p, 0);
+   P_NV90B5_OFFSET_IN_LOWER(p, 0);
+   P_NV90B5_OFFSET_OUT_UPPER(p, 0);
+   P_NV90B5_OFFSET_OUT_LOWER(p, 0);
+   P_MTHD(p, NV90B5, LINE_LENGTH_IN);
+   P_NV90B5_LINE_LENGTH_IN(p, 0);
+   P_IMMD_WORD(p, NV90B5, LAUNCH_DMA, {
+      .data_transfer_type = DATA_TRANSFER_TYPE_PIPELINED,
+      .multi_line_enable = MULTI_LINE_ENABLE_FALSE,
+      .flush_enable = FLUSH_ENABLE_TRUE,
+      .src_memory_layout = SRC_MEMORY_LAYOUT_PITCH,
+      .dst_memory_layout = DST_MEMORY_LAYOUT_PITCH,
+      .remap_enable = REMAP_ENABLE_FALSE,
+   });
+   assert(nv_push_dw_count(p) == NVK_COPY_INDIRECT_CMD_WORDS);
+
+   nir_def *i = invocation_index(b);
+   nir_push_if(b, nir_ult(b, i, count));
+   {
+      /* VkCopyMemoryIndirectCommandKHR { srcAddress, dstAddress, size } */
+      nir_def *cmd = nir_iadd(b, in, nir_imul(b, nir_u2u64(b, i), in_stride));
+      nir_def *src = nir_load_global(b, 1, 64, cmd, .align_mul = 8);
+      nir_def *dst = nir_load_global(b, 1, 64, nir_iadd_imm(b, cmd, 8), .align_mul = 8);
+      nir_def *size = nir_load_global(b, 1, 64, nir_iadd_imm(b, cmd, 16), .align_mul = 8);
+
+      nir_def *w[NVK_COPY_INDIRECT_CMD_WORDS] = {
+         nir_imm_int(b, tmpl[0]),
+         nir_unpack_64_2x32_split_y(b, src),
+         nir_unpack_64_2x32_split_x(b, src),
+         nir_unpack_64_2x32_split_y(b, dst),
+         nir_unpack_64_2x32_split_x(b, dst),
+         nir_imm_int(b, tmpl[5]),
+         nir_u2u32(b, size),
+         nir_imm_int(b, tmpl[7]),
+      };
+      nir_def *base = nir_iadd(b, nir_u2u64(b, out),
+                               nir_imul_imm(b, nir_u2u64(b, i), NVK_COPY_INDIRECT_CMD_BYTES));
+      for (unsigned k = 0; k < NVK_COPY_INDIRECT_CMD_WORDS; k++)
+         nir_store_global(b, w[k], nir_iadd_imm(b, base, 4 * k), .align_mul = 4);
+   }
+   nir_pop_if(b, NULL);
+}
diff --git a/src/nouveau/vulkan/macos_nvkcl/nvkcl.h b/src/nouveau/vulkan/macos_nvkcl/nvkcl.h
