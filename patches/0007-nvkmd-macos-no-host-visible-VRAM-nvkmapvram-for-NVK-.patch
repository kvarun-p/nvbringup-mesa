 }
 
 /* The kernel keeps one CPU mapping per memory object; internal and client maps
- * share it, so it is reference counted here.
+ * share it, so it is reference counted here (a pinned one stays until freed).
  */
 static VkResult
 nvkmd_macos_mem_map(struct nvkmd_mem *_mem,
@@ -133,7 +182,7 @@ nvkmd_macos_mem_map(struct nvkmd_mem *_mem,
 
    VkResult result = VK_SUCCESS;
    simple_mtx_lock(&mem->kmap_mutex);
-   if (mem->kmap_count == 0) {
+   if (mem->kmap == NULL) {
       void *map = NULL;
       int err = nvmac_mem_map(dev->nv, mem->handle, &map, NULL);
       if (err)
@@ -160,7 +209,7 @@ nvkmd_macos_mem_unmap(struct nvkmd_mem *_mem,
 
    simple_mtx_lock(&mem->kmap_mutex);
    assert(mem->kmap_count > 0 && map == mem->kmap);
-   if (--mem->kmap_count == 0) {
+   if (--mem->kmap_count == 0 && !mem->kmap_pinned) {
       nvmac_mem_unmap(dev->nv, mem->handle);
       mem->kmap = NULL;
    }
diff --git a/src/nouveau/vulkan/nvkmd/macos/nvkmd_macos_pdev.c b/src/nouveau/vulkan/nvkmd/macos/nvkmd_macos_pdev.c
index 97476881..d0ce60b1 100644
--- a/src/nouveau/vulkan/nvkmd/macos/nvkmd_macos_pdev.c
+++ b/src/nouveau/vulkan/nvkmd/macos/nvkmd_macos_pdev.c
@@ -7,11 +7,72 @@
 
 #include "util/cache_ops.h"
 #include "util/u_memory.h"
+#include "util/log.h"
 #include "vk_log.h"
 
 #include <IOKit/IOReturn.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
+#include <sys/sysctl.h>
+
+bool
+nvkmd_macos_boot_arg(const char *name, char *value, size_t size)
+{
+   char args[1024];
+   size_t len = sizeof(args) - 1;
+   if (sysctlbyname("kern.bootargs", args, &len, NULL, 0))
+      return false;
+   args[len] = '\0';
+
+   const size_t n = strlen(name);
+   char *save;
+   for (char *tok = strtok_r(args, " \t", &save); tok; tok = strtok_r(NULL, " \t", &save)) {
+      if (strncmp(tok, name, n) || (tok[n] != '\0' && tok[n] != '='))
+         continue;
+      snprintf(value, size, "%s", tok[n] ? tok + n + 1 : "");
+      return true;
+   }
+   return false;
+}
+
+/* nvkmapvram=<list>: "1" or "all" (every LOCAL|CAN_MAP buffer), or a comma list
+ * of "desc" (descriptor pools and tables) and "cmd" or "cmd:<n>" (command chunks,
+ * at most n per device). "0" or absent: none. NVK_MACOS_MAPVRAM overrides it for
+ * one process (for measuring; the kext's cap on held BAR1 applies either way).
+ */
+static void
+parse_map_local_vram(struct nvkmd_macos_pdev *pdev)
+{
+   char v[128];
+   pdev->map_local_vram = 0;
+   pdev->map_cmd_max = UINT32_MAX;
+   const char *env = getenv("NVK_MACOS_MAPVRAM");
+   if (env)
+      snprintf(v, sizeof(v), "%s", env);
+   else if (!nvkmd_macos_boot_arg("nvkmapvram", v, sizeof(v)))
+      return;
+   if (!strcmp(v, "") || !strcmp(v, "1") || !strcmp(v, "all")) {
+      pdev->map_local_vram = NVKMD_MACOS_MAP_ALL;
+      return;
+   }
+   char *save;
+   for (char *tok = strtok_r(v, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
+      char *end = NULL;
+      unsigned long max = UINT32_MAX;
+      if (!strncmp(tok, "cmd:", 4) && tok[4])
+         max = strtoul(tok + 4, &end, 10);
+      if (!strcmp(tok, "0"))
+         continue;
+      else if (!strcmp(tok, "desc"))
+         pdev->map_local_vram |= NVKMD_MACOS_MAP_DESC;
+      else if (!strcmp(tok, "cmd") || (end && !*end && max < UINT32_MAX)) {
+         pdev->map_local_vram |= NVKMD_MACOS_MAP_CMD;
+         pdev->map_cmd_max = max;
+      } else
+         mesa_logw("NVBringup: nvkmapvram: ignoring \"%s\"", tok);
+   }
+}
 
 VkResult
 nvkmd_macos_result(struct vk_object_base *log_obj, int err, VkResult fallback, const char *what)
@@ -124,6 +185,7 @@ nvkmd_macos_try_create_pdev(struct vk_object_base *log_obj,
    };
    pdev->base.bind_align_B = i->bind_align;
    pdev->nv = nv;
+   parse_map_local_vram(pdev);
 
    pdev->binary_type = vk_sync_binary_get_type(&nvkmd_macos_sync_type);
    pdev->sync_types[0] = &nvkmd_macos_sync_type;
diff --git a/src/nouveau/vulkan/nvkmd/nvkmd.h b/src/nouveau/vulkan/nvkmd/nvkmd.h
index fbbd41f0..30cea23c 100644
--- a/src/nouveau/vulkan/nvkmd/nvkmd.h
+++ b/src/nouveau/vulkan/nvkmd/nvkmd.h
@@ -56,6 +56,12 @@ enum nvkmd_mem_flags {
 
    /** This memory object has coherent CPU maps */
    NVKMD_MEM_COHERENT   = 1 << 5,
+
+   /** Placement hints: what the memory is for.  A backend may use them to
+    * place CPU-mapped LOCAL memory (the macOS one does) or ignore them.
+    */
+   NVKMD_MEM_USE_CMD    = 1 << 6,  /**< command buffer chunks */
+   NVKMD_MEM_USE_DESC   = 1 << 7,  /**< descriptor pools and tables */
 };
 
 #define NVKMD_MEM_PLACEMENT_FLAGS \
