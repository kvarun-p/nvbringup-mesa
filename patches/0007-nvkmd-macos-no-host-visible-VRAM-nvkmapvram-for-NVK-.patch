+         map_vram = true;
+      else if ((mpdev->map_local_vram & NVKMD_MACOS_MAP_DESC) && (flags & NVKMD_MEM_USE_DESC))
+         map_vram = true;
+      else if ((mpdev->map_local_vram & NVKMD_MACOS_MAP_CMD) && (flags & NVKMD_MEM_USE_CMD)) {
+         /* Take a slot in the budget; given back if this doesn't end in VRAM. */
+         map_cmd = p_atomic_inc_return(&dev->map_cmd_count) <= mpdev->map_cmd_max;
+         if (!map_cmd)
